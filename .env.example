# Copy to .env.local for local development (npm run dev:api + npm run web).
EXPO_PUBLIC_API_URL=http://localhost:8799
# DATABASE_URL=.data/pglite            # default; or a Neon postgres:// URL
# DATABASE_URL=postgres://postgres:postgres@db.localtest.me:5432/rolar   # Docker (npm run db:up)
# BETTER_AUTH_SECRET=                  # required in production (openssl rand -base64 32)
# RESEND_API_KEY= / EMAIL_FROM=        # without them the login code is printed in the API log
# ADMIN_EMAILS=voce@email.com          # who can open /admin (academy verification); comma-separated
# GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET= and EXPO_PUBLIC_GOOGLE_LOGIN=1
# Donation links (a provider left empty is hidden on the "Apoie" page):
# EXPO_PUBLIC_DONATE_GITHUB=https://github.com/sponsors/<user>
# EXPO_PUBLIC_DONATE_KOFI=https://ko-fi.com/<user>
# EXPO_PUBLIC_DONATE_LIBERAPAY=https://liberapay.com/<user>
# EXPO_PUBLIC_DONATE_PAGE=https://<domain>/apoie        # where the Android app sends donors
# EXPO_PUBLIC_REPO_URL=https://github.com/<user>/<repo>
