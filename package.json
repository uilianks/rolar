  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.0",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "dev:api": "tsx watch --env-file-if-exists=.env.local server/dev.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local server/db/seed.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "dev:api:pg": "DATABASE_URL=postgres://postgres:postgres@db.localtest.me:5432/tatame tsx watch --env-file-if-exists=.env.local server/dev.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "build:web": "expo export -p web",
    "vercel-build": "npm run db:migrate && npm run build:web"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
